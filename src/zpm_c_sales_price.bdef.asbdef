projection;
strict ( 2 );
use draft;

define behavior for ZPM_C_SALES_PRICE //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action UploadExcel;
  use action Approve;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Child { create; with draft; }
}

define behavior for ZPM_C_SCALESPRICE
{
  use update;
  use delete;

  use association _Parent { with draft; }
}